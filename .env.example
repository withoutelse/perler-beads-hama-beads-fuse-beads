APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./storage/pindou.db
STORAGE_DIR=./storage
CORS_ORIGINS=["http://localhost:5173"]

# Tripo OpenAPI configuration. Single-user local mode: GLB + polling.
TRIPO_API_BASE_URL=https://api.tripo3d.ai/v2/openapi
TRIPO_API_KEY=
TRIPO_MODEL_VERSION=v2.5-20250123
TRIPO_POLL_INTERVAL_S=2.0
TRIPO_TASK_TIMEOUT_S=600
TRIPO_REQUEST_TIMEOUT_S=120
